# ==========================================
# Generative AI Toolkit - Environment Configuration
# ==========================================

# Base URL for API requests (leave default or specify custom/proxy endpoint)
# e.g., https://api.openai.com/v1 or custom API proxy gateway
BASE_URL=https://api.openai.com/v1

# API Key for model providers (OpenAI, Anthropic, or third-party proxy)
API_KEY=your_api_key_here

# Target Model Identifier
# Examples:
# - OpenAI: gpt-4o-mini, gpt-4o
# - Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# - Ollama: gemma3:4b, llama3.2:3b, qwen2.5:3b
MODEL_NAME=gpt-4o-mini
